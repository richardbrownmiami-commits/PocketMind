<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:elevation="0dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/background"
                app:title="@string/app_name"
                app:titleTextAppearance="@style/TextAppearance.PocketMind.Display"
                app:titleTextColor="@color/primary" />
        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:id="@+id/remote_session_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/error"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/remote_session_banner_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/remote_active_banner_default"
                android:textColor="@color/background"
                android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/remote_session_stop_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:text="@string/remote_stop"
                android:textColor="@color/on_background"
                app:backgroundTint="@color/background" />
        </LinearLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="@dimen/elevation_bottom_bar"
            app:itemActiveIndicatorStyle="@style/Widget.PocketMind.BottomNavigation.ActiveIndicator"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/bottom_nav_item_tint"
            app:itemTextAppearanceActive="@style/TextAppearance.PocketMind.Label"
            app:itemTextAppearanceInactive="@style/TextAppearance.PocketMind.Label"
            app:itemTextColor="@color/bottom_nav_item_tint"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_navigation" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
