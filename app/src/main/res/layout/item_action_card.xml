<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/action_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_variant"
    app:cardCornerRadius="@dimen/radius_action_card"
    app:cardElevation="@dimen/elevation_card"
    app:strokeColor="@color/divider"
    app:strokeWidth="@dimen/stroke_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/action_status_border"
            android:layout_width="@dimen/action_border_width"
            android:layout_height="match_parent"
            android:background="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/action_status_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:tint="@color/primary" />

                <TextView
                    android:id="@+id/action_status_label"
                    style="@style/TextAppearance.PocketMind.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/action_tool_name"
                style="@style/TextAppearance.PocketMind.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textColor="@color/on_surface" />

            <TextView
                android:id="@+id/action_message"
                style="@style/TextAppearance.PocketMind.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
