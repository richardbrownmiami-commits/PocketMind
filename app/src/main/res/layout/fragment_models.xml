<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="@dimen/space_16">

    <TextView
        android:id="@+id/models_title"
        style="@style/TextAppearance.PocketMind.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/models_title" />

    <TextView
        android:id="@+id/models_subtitle"
        style="@style/TextAppearance.PocketMind.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="@string/models_subtitle" />

    <TextView
        android:id="@+id/models_message"
        style="@style/TextAppearance.PocketMind.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="@string/models_empty" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/import_model_button"
            style="@style/Widget.PocketMind.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:text="@string/import_gguf" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/load_model_button"
            style="@style/Widget.PocketMind.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/load_model" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/import_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/models_status"
        style="@style/TextAppearance.PocketMind.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/no_model_loaded" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/unload_model_button"
        style="@style/Widget.PocketMind.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/unload_model" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_12"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/model_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
