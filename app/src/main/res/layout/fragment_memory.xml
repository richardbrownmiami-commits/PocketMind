<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/memory_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_16"
            android:paddingEnd="@dimen/space_16"
            android:paddingBottom="@dimen/space_16">

            <TextView
                style="@style/TextAppearance.PocketMind.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memory_title" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/memory_options_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="@color/divider"
                app:strokeWidth="@dimen/stroke_width">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_12">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/facts_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/remember_facts" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/recall_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/recall_conversations" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.PocketMind.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_16"
                android:text="@string/saved_facts"
                android:textAllCaps="true"
                android:textColor="@color/primary" />

            <LinearLayout
                android:id="@+id/facts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                app:dividerColor="@color/divider" />

            <TextView
                style="@style/TextAppearance.PocketMind.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_16"
                android:text="@string/recent_actions"
                android:textAllCaps="true"
                android:textColor="@color/primary" />

            <LinearLayout
                android:id="@+id/actions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                app:dividerColor="@color/divider" />

            <TextView
                style="@style/TextAppearance.PocketMind.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_16"
                android:text="@string/saved_notes"
                android:textAllCaps="true"
                android:textColor="@color/primary" />

            <LinearLayout
                android:id="@+id/notes_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clear_memory_button"
        style="@style/Widget.PocketMind.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginBottom="@dimen/space_12"
        android:text="@string/clear_memory"
        android:textColor="@color/error"
        app:strokeColor="@color/error" />
</LinearLayout>
